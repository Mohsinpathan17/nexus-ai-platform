# Firebase web-app configuration is public, not an AI/server secret.
# Used only by npm run build:cloud. Copy into an ignored .env.local file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Enable only after configuring GitHub OAuth in Firebase.
VITE_FIREBASE_GITHUB=0
