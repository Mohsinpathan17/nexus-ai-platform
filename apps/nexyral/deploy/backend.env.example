# Operator template. Replace reserved example domains; inject through your service manager.
NODE_ENV=production
NEXYRAL_APP_HOST=app.your-domain.example
NEXYRAL_PREVIEW_HOSTNAME=preview.your-domain.example
NEXYRAL_APP_ORIGINS=https://app.your-domain.example
NEXYRAL_PREVIEW_ORIGIN=https://preview.your-domain.example
NEXYRAL_RECOVERY_APP_ORIGIN=https://app.your-domain.example
NEXYRAL_DB_PATH=/srv/nexyral/data/workspace.sqlite
NEXYRAL_API_HOST=127.0.0.1
NEXYRAL_TRUSTED_PROXIES=127.0.0.1
NEXYRAL_API_PORT=8787
NEXYRAL_PREVIEW_HOST=127.0.0.2
NEXYRAL_PREVIEW_PORT=8788
NEXYRAL_START_WORKER=0
NEXYRAL_ENABLE_BUILDS=0
# Worker enablement is a separate explicit action after inspecting pending queues.
# NEXYRAL_PLANNING_MODEL=qwen2.5-coder:1.5b
# Optional real account providers; configure only on the server, never with VITE_ secrets.
# GitHub OAuth app callback: https://app.your-domain.com/api/auth/github/callback
# NEXYRAL_AUTH_ORIGIN=https://app.your-domain.com
# NEXYRAL_GITHUB_CLIENT_ID=your-oauth-client-id
# NEXYRAL_GITHUB_CLIENT_SECRET=secure-server-secret
# SMTP credentials are SMTP credentials, not an AWS account ID or console password.
# NEXYRAL_SMTP_HOST=email-smtp.REGION.amazonaws.com
# NEXYRAL_SMTP_PORT=587
# NEXYRAL_SMTP_USER=secure-smtp-username
# NEXYRAL_SMTP_PASSWORD=secure-smtp-password
# NEXYRAL_MAIL_FROM=noreply@your-domain.com
# NEXYRAL_SUPPORT_EMAIL=support@your-domain.com
# After configuring/testing all account providers, require them at API startup:
# NEXYRAL_REQUIRE_ACCOUNT_PROVIDERS=1
