{
  "name": "nexyral",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/services.ts dev",
    "build": "tsc -b && tsc -p tsconfig.server.json && node scripts/copy-worker-assets.ts && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json --noEmit",
    "dev:api": "node --watch server/index.ts",
    "start": "node server-dist/server/index.js",
    "start:preview": "node server-dist/server/preview-entry.js",
    "dev:preview": "node --watch server/preview-entry.ts",
    "build:executor": "node scripts/build-executor.ts",
    "test:api": "node --test server/*.test.ts",
    "worker": "node server/worker-entry.ts",
    "start:worker": "node server-dist/server/worker-entry.js",
    "build:demo": "VITE_PUBLIC_DEMO=1 npm run build && node scripts/mark-demo.ts",
    "deploy:demo": "node --use-env-proxy scripts/deploy-demo.ts",
    "db:maintenance": "node scripts/database-maintenance.ts",
    "services": "node scripts/services.ts serve",
    "account:recovery": "node scripts/issue-recovery.ts",
    "package:backend": "node scripts/package-backend.ts",
    "preflight:backend": "node scripts/deployment-preflight.ts",
    "smoke:https": "node --use-env-proxy scripts/https-smoke.ts",
    "build:cloud": "VITE_SERVERLESS=1 npm run build && npm run typecheck:cloud",
    "typecheck:cloud": "tsc -p tsconfig.cloudflare.json",
    "dev:cloud": "wrangler dev",
    "deploy:cloud": "npm run preflight:cloud && npm run build:cloud && wrangler deploy",
    "test:cloud": "node --test cloudflare/*.test.ts",
    "preflight:cloud": "node scripts/cloud-preflight.ts",
    "deploy:cloud:staging": "npm run preflight:cloud -- --allow-disabled-generation && npm run build:cloud && wrangler deploy",
    "test:cloud:ui": "playwright test --config playwright.cloud.config.ts",
    "test:export": "node --test tests/cloud/export.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "@tailwindcss/vite": "^4.3.3",
    "firebase": "^13.0.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "nodemailer": "^10.0.16",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "miniflare": "^5.20261006.1-alpha",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.149.0"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
