{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types"],
    "lib": ["ES2023", "DOM"]
  },
  "include": ["cloudflare/*.ts"],
  "exclude": ["cloudflare/*.test.ts"]
}
