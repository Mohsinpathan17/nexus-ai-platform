{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexyral",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-09",
  "workers_dev": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nexyral",
      "database_id": "8b230964-c4f9-4d30-8b12-b5a828beb571",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "nexyral",
    "GEMINI_MODEL": "gemini-3.5-flash",
    "DAILY_GENERATION_LIMIT": "10"
  },
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "nexyral.online",
      "custom_domain": true,
      "zone_name": "nexyral.online"
    }
  ],
  "preview_urls": false
}
